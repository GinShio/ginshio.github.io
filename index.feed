\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw:block tw:m-0 tw:p-0\"\u003e\u003ccode \n    id=\"codeblock-id-367\" \n    class=\"\n      chroma \n      tw:block! \n      tw:p-0\n      tw:m-0\n      tw:transition-[max-height] \n      tw:duration-500 \n      tw:ease-in-out \n      tw:group-[.is-closed]:max-h-0! \n      tw:group-[.is-wrap]:text-wrap\n      tw:overflow-y-hidden\n      tw:overflow-x-auto\n      tw:scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"k\"\u003etypedef\u003c/span\u003e \u003cspan class=\"k\"\u003estruct\u003c/span\u003e \u003cspan class=\"n\"\u003eYYLTYPE\u003c/span\u003e \u003cspan class=\"p\"\u003e{\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"kt\"\u003eint\u003c/span\u003e \u003cspan class=\"n\"\u003efirst_line\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"kt\"\u003eint\u003c/span\u003e \u003cspan class=\"n\"\u003efirst_column\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"kt\"\u003eint\u003c/span\u003e \u003cspan class=\"n\"\u003elast_line\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"kt\"\u003eint\u003c/span\u003e \u003cspan class=\"n\"\u003elast_column\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"p\"\u003e}\u003c/span\u003e \u003cspan class=\"n\"\u003eYYLTYPE\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e这些字段在解析开始时被初始化为 yylloc 的 \u003ccode\u003e1\u003c/code\u003e。自定义位置类型的话，需要使用\n\u003ccode\u003e%initial-action\u003c/code\u003e 操作。\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003c!--list-separator--\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e位置与行为\u003c/p\u003e\n\u003cp\u003e与访问规则类似，访问位置使用表达式 \u003ccode\u003e@N\u003c/code\u003e，而左边的非终结符位置为 \u003ccode\u003e@$\u003c/code\u003e。位置也可以用命名位置 \u003ccode\u003e@[NAME]\u003c/code\u003e 或 \u003ccode\u003e@NAME\u003c/code\u003e。\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-closed show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.is-open]:rotate-90 tw:transition-[transform] tw:duration-500 tw:ease-in-out tw:print:hidden! tw:w-min tw:h-min tw:my-1 tw:mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"tw:select-none tw:my-1! tw:block\"\u003etext\u003c/span\u003e\n      \u003c/button\u003e\n\n   \u003cdiv class=\"tw:flex\"\u003e\n    
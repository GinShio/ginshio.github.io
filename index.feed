:group-[.is-wrap]:text-wrap\n      tw:overflow-y-hidden\n      tw:overflow-x-auto\n      tw:scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"nb\"\u003esetq\u003c/span\u003e \u003cspan class=\"nf\"\u003euser-full-name\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;GinShio\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e      \u003cspan class=\"nv\"\u003euser-mail-address\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;ginshio78@gmail.com\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e      \u003cspan class=\"nv\"\u003euser-gpg-key\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;9E2949D214995C7E\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e      \u003cspan class=\"nv\"\u003ewakatime-api-key\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;cb5cccd0-e5a0-4922-abfd-748a42a96cae\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e      \u003cspan class=\"nv\"\u003eorg-directory\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;~/org\u0026#34;\u003c/span\u003e\u003cspan class=\"p\"\u003e)\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e显然这可以被 GPG 或其他程序使用。\u003c/p\u003e\n\u003ch3 id=\"设置默认值\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e8%ae%be%e7%bd%ae%e9%bb%98%e8%ae%a4%e5%80%bc\" class=\"header-mark\"\u003e\u003c/a\u003e设置默认值\u003c/h3\u003e\u003cp\u003e尝试一下别人的默认值，比如 \u003ca href=\"https://github.com/angrybacon/dotemacs/blob/master/dotemacs.org#use-better-defaults\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eangrybacon/dotemacs\u003c/a\u003e\u003c/p\u003e\n\u003cdiv 
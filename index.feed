\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;CREATE USER \u003c/span\u003e\u003cspan class=\"nv\"\u003e$nextcloud_db_user\u003c/span\u003e\u003cspan class=\"s2\"\u003e WITH PASSWORD \u0026#39;\u003c/span\u003e\u003cspan class=\"nv\"\u003e$nextcloud_db_passwd\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#39;\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nf\"\u003esudo\u003c/span\u003e \u003cspan class=\"na\"\u003e-u\u003c/span\u003e postgres \u003cspan class=\"na\"\u003e-H\u003c/span\u003e psql \u003cspan class=\"na\"\u003e-c\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;CREATE DATABASE \u003c/span\u003e\u003cspan class=\"nv\"\u003e$nextcloud_db_name\u003c/span\u003e\u003cspan class=\"s2\"\u003e OWNER \u003c/span\u003e\u003cspan class=\"nv\"\u003e$nextcloud_db_user\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003c/dd\u003e\n\u003cdt\u003eNginxm\u003c/dt\u003e\n\u003cdd\u003e配置网站，修改 \u003ca href=\"https://docs.nextcloud.com/server/20/admin_manual/installation/nginx.html#nextcloud-in-the-webroot-of-nginx\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e官方示例配置文件\u003c/a\u003e 并保存在\n\u003ccode\u003e/etc/nginx/sites-available/nextcloud\u003c/code\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.is-open]:rotate-90 tw:transition-[transform] tw:duration-500 tw:ease-in-out tw:print:hidden! tw:w-min tw:h-min tw:my-1 tw:mx-1\
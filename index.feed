lass=\"cl\"\u003e\u003cspan class=\"nv\"\u003eMESA\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003e\u003cspan class=\"nv\"\u003e$HOME\u003c/span\u003e/.local/lib/mesa \u003cspan class=\"nv\"\u003eLD_LIBRARY_PATH\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003e\u003cspan class=\"nv\"\u003e$MESA\u003c/span\u003e/lib64 \u003cspan class=\"se\"\u003e\\\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    \u003cspan class=\"nv\"\u003eRUSTICL_ENABLE\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003eradeonsi \u003cspan class=\"se\"\u003e\\\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e    clinfo\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003chr\u003e\n\u003ch2 id=\"useful-links\" class=\"headerLink\"\u003e\n    \u003ca href=\"#useful-links\" class=\"header-mark\"\u003e\u003c/a\u003eUseful links\u003c/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://www.phoronix.com/news/Mesa-Stripping-GLSL-To-TGSI\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eMesa Prepares To Drop Old GLSL-To-TGSI - Big Code Removal, Win For\nPerformance \u0026amp; Fixes\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://archive.fosdem.org/2018/schedule/event/radeonsi/attachments/slides/2253/export/events/attachments/radeonsi/slides/2253/fosdem2018_shaders.pdf\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eNIR in RadeonSI\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://docs.mesa3d.org/sourcetree.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eSource Code Tree\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://gist.github.com/Venemo/a9483106565df3a83fc67a411191edbd\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eHow to build and use mesa from source\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://steamcommunity.com/games/221410/announcements/detail/1602634609636894200\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eHelp us test ACO, a new Mesa shader compiler for AMD graphics!\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://docs.mesa3d.org/envvars.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eEnvironment Variables for Mesa\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://gpuopen.com/gdc-presentations/2019/gdc-2019-s6-gpu-performance-revealed.pdf\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eAMD GPU Performance Revealed\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n",

n class=\"s\"\u003e\u0026#34;𝙏\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:subtitle\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;𝙩\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:author\u003c/span\u003e        \u003cspan class=\"s\"\u003e\u0026#34;𝘼\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:date\u003c/span\u003e          \u003cspan class=\"s\"\u003e\u0026#34;𝘿\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:property\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;☸\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:options\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;⌥\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:startup\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;⏻\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:macro\u003c/span\u003e         \u003cspan class=\"s\"\u003e\u0026#34;𝓜\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:html_head\u003c/span\u003e     \u003cspan class=\"s\"\u003e\u0026#34;🅷\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:html\u003c/span\u003e          \u003cspan class=\"s\"\u003e\u0026#34;🅗\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:latex_class\u003c/span\u003e   \u003cspan class=\"s\"\u003e\u0026#34;🄻\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:latex_header\u003c/span\u003e  \u003cspan class=\"s\"\u003e\u0026#34;🅻\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:beamer_header\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;🅑\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:latex\u003c/span\u003e         \u003cspan class=\"s\"\u003e\u0026#34;🅛\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:attr_latex\u003c/span\u003e    \u003cspan class=\"s\"\u003e\u0026#34;🄛\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:attr_html\u003c/span\u003e     \u003cspan class=\"s\"\u003e\u0026#34;🄗\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:attr_org\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;⒪\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:begin_quote\u003c/span\u003e   \u003cspan class=\"s\"\u003e\u0026#34;❝\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:end_quote\u003c/span\u003e     \u003cspan class=\"s\"\u003e\u0026#34;❞\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:caption\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;☰\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:header\u003c/span\u003e        \u003cspan class=\"s\"\u003e\u0026#34;›\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:results\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;🠶\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:begin_export\u003c/span\u003e  \u003cspan class=\"s\"\u003e\u0026#34;⏩\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:end_export\u003c/span\u003e    \u003cspan class=\"s\"\u003e\u0026#34;⏪\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:properties\u003c/span\u003e    \u003cspan class=\"s\"\u003e\u0026#34;⚙\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:end\u003c/span\u003e           \u003cspan class=\"s\"\u003e\u0026#34;∎\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:priority_a\u003c/span\u003e   \u003cspan class=\"o\"\u003e,\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"nf\"\u003epropertize\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;⚑\u0026#34;\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;face\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;all-the-icons-red\u003c/span\u003e\u003cspan class=\"p\"\u003e)\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:priority_b\u003c/span\u003e   \u003cspan class=\"o\"\u003e,\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"nf\"\u003epropertize\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;⬆\u0026#34;\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;face\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;all-the-icons-orange\u003c/span\u003e\u003cspan class=\"p\"\u003e)\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:priority_c\u003c/span\u003e   \u003cspan class=\"o\"\u003e,\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"nf\"\u003epropertize\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;■\u0026#34;\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;face\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;all-the-icons-yellow\u003c/span\u003e\u003cspan class=\"p\"\u003e)\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:priority_d\u003c/span\u003e   \u003cspan class=\"o\"\u003e,\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"nf\"\u003epropertize\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;⬇\u0026#34;\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;face\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;all-the-icons-green\u003c/span\u003e\u003cspan class=\"p\"\u003e)\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e            \u003cspan class=\"nb\"\u003e:priority_e\u003c/span\u003e   \u003cspan class=\"o\"\u003e,\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"nf\"\u003epropertize\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;❓\u0026#34;\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;face\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;all-the-icons-blue\u003c/span\u003e\u003cspan class=\"p\"\u003e)))\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"nv\"\u003eset-ligatures!\u003c/span\u003e \u003cspan class=\"ss\"\u003e\u0026#39;org-mode\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:merge\u003c/span\u003e \u003cspan class=\"no\"\u003et\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:checkbox\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;[ ]\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:pending\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;[-]\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:checkedbox\u003c/span\u003e    \u003cspan class=\"s\"\u003e\u0026#34;[X]\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:list_property\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;::\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:em_dash\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;---\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:ellipsis\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;...\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:arrow_right\u003c/span\u003e   \u003cspan class=\"s\"\u003e\u0026#34;-\u0026gt;\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:arrow_left\u003c/span\u003e    \u003cspan class=\"s\"\u003e\u0026#34;\u0026lt;-\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:title\u003c/span\u003e         \u003cspan class=\"s\"\u003e\u0026#34;#+title:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:subtitle\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;#+subtitle:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:author\u003c/span\u003e        \u003cspan class=\"s\"\u003e\u0026#34;#+author:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:date\u003c/span\u003e          \u003cspan class=\"s\"\u003e\u0026#34;#+date:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:property\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;#+property:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:options\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;#+options:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:startup\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;#+startup:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:macro\u003c/span\u003e         \u003cspan class=\"s\"\u003e\u0026#34;#+macro:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:html_head\u003c/span\u003e     \u003cspan class=\"s\"\u003e\u0026#34;#+html_head:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:html\u003c/span\u003e          \u003cspan class=\"s\"\u003e\u0026#34;#+html:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:latex_class\u003c/span\u003e   \u003cspan class=\"s\"\u003e\u0026#34;#+latex_class:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:latex_header\u003c/span\u003e  \u003cspan class=\"s\"\u003e\u0026#34;#+latex_header:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:beamer_header\u003c/span\u003e \u003cspan class=\"s\"\u003e\u0026#34;#+beamer_header:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:latex\u003c/span\u003e         \u003cspan class=\"s\"\u003e\u0026#34;#+latex:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:attr_latex\u003c/span\u003e    \u003cspan class=\"s\"\u003e\u0026#34;#+attr_latex:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:attr_html\u003c/span\u003e     \u003cspan class=\"s\"\u003e\u0026#34;#+attr_html:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:attr_org\u003c/span\u003e      \u003cspan class=\"s\"\u003e\u0026#34;#+attr_org:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:begin_quote\u003c/span\u003e   \u003cspan class=\"s\"\u003e\u0026#34;#+begin_quote\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:end_quote\u003c/span\u003e     \u003cspan class=\"s\"\u003e\u0026#34;#+end_quote\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:caption\u003c/span\u003e       \u003cspan class=\"s\"\u003e\u0026#34;#+caption:\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003e:header\u003c/span\u003e        \u003cspan class=\"s\"\u003e\u0026#34;#+header:\u0026#34;\u003c/span\u003e\n\u003c/span\
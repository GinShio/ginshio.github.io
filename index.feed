03cspan class=\"c1\"\u003e# \u0026#39;2 + 7 = 9\u0026#39;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"s2\"\u003e\u0026#34;Elixir\u0026#34;\u003c/span\u003e \u003cspan class=\"o\"\u003e=~\u003c/span\u003e \u003cspan class=\"sx\"\u003e~r/elixir/\u003c/span\u003e \u003cspan class=\"c1\"\u003e# false\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"s2\"\u003e\u0026#34;elixir\u0026#34;\u003c/span\u003e \u003cspan class=\"o\"\u003e=~\u003c/span\u003e \u003cspan class=\"sx\"\u003e~r/elixir/\u003c/span\u003e \u003cspan class=\"c1\"\u003e# true\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"sx\"\u003e~w/i love elixir school/\u003c/span\u003e \u003cspan class=\"c1\"\u003e# [\u0026#34;i\u0026#34;, \u0026#34;love\u0026#34;, \u0026#34;elixir\u0026#34;, \u0026#34;school\u0026#34;]\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003ch2 id=\"时间\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%97%b6%e9%97%b4\" class=\"header-mark\"\u003e\u003c/a\u003e时间\u003c/h2\u003e\u003cp\u003eElixir 内置了几个处理时间的模块，让我们试试最简单的，当前的 UTC 时间\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.is-open]:rotate-90 tw:transition-[transform] tw:duration-500 tw:ease-in-out tw:print:hidden! tw:w-min tw:h-min tw:my-1 tw:mx-1\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.o
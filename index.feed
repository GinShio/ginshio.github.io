-auto\n      tw:scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eActive Internet connections (servers and established)\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eProto Recv-Q Send-Q Local Address           Foreign Address         State\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003etcp        0      0 0.0.0.0:echo            0.0.0.0:*               LISTEN\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003etcp        0      0 192.168.0.105:46956     192.168.0.105:echo      ESTABLISHED\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003etcp        0      0 192.168.0.105:echo      192.168.0.105:46956     ESTABLISHED\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003etcp        0      0 GinShio:echo            GinShio:32996           ESTABLISHED\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003etcp        0      0 GinShio:32996           GinShio:echo            ESTABLISHED\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e还可以通过 ps 命令来查看进程的状态与关系。我这里查看到服务端在 \u003ccode\u003epts/4\u003c/code\u003e 上启动，而本地客户端在 \u003ccode\u003epts/5\u003c/code\u003e 上，wlan0 客户端在 \u003ccode\u003epts/6\u003c/code\u003e 上，通过以下 ps 命令查看\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:my-2\"\u003e\n  \u003cdiv class=\"\n    \n    tw:flex \n    tw:flex-row\n    tw:flex-1 \n    tw:justify-between \n    tw:w-full tw:bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        code-block-button\n        tw:mx-2 \n        tw:flex\n        tw:flex-row\n        tw:flex-1\"\n      aria-hidden=\"true\"\u003e\n          \u003cspan class=\"tw:group-[.is-open]:rotate-90 tw:transition
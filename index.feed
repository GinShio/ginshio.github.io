auto\n      tw:scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nf\"\u003esudo\u003c/span\u003e \u003cspan class=\"nf\"\u003euseradd\u003c/span\u003e \u003cspan class=\"nv\"\u003e$lychee_db_user\u003c/span\u003e \u003cspan class=\"na\"\u003e--create-home\u003c/span\u003e \u003cspan class=\"na\"\u003e--shell\u003c/span\u003e /sbin/nologin\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nf\"\u003esudo\u003c/span\u003e \u003cspan class=\"na\"\u003e-u\u003c/span\u003e postgres \u003cspan class=\"na\"\u003e-H\u003c/span\u003e psql \u003cspan class=\"na\"\u003e-c\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;CREATE USER \u003c/span\u003e\u003cspan class=\"nv\"\u003e$lychee_db_user\u003c/span\u003e\u003cspan class=\"s2\"\u003e WITH PASSWORD \u0026#39;\u003c/span\u003e\u003cspan class=\"nv\"\u003e$lychee_db_passwd\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#39;\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nf\"\u003esudo\u003c/span\u003e \u003cspan class=\"na\"\u003e-u\u003c/span\u003e postgres \u003cspan class=\"na\"\u003e-H\u003c/span\u003e psql \u003cspan class=\"na\"\u003e-c\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;CREATE DATABASE \u003c/span\u003e\u003cspan class=\"nv\"\u003e$lychee_db_name\u003c/span\u003e\u003cspan class=\"s2\"\u003e OWNER \u003c/span\u003e\u003cspan class=\"nv\"\u003e$lychee_db_user\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e我们将安装 v4.0.8，更多详细版本信息请浏览 \u003ca href=\"https://lycheeorg.github.io/docs/releases.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e更新日志\u003c/a\u003e\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw:group tw:m